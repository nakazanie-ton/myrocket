{
  "name": "xrocket-mcp",
  "version": "0.4.0",
  "description": "Live public xRocket market data for AI clients over MCP",
  "type": "module",
  "license": "MIT",
  "author": "nakazanie-ton",
  "homepage": "https://xrocket-mcp-production.up.railway.app/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nakazanie-ton/myrocket.git"
  },
  "bugs": {
    "url": "https://github.com/nakazanie-ton/myrocket/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "xrocket",
    "crypto-exchange",
    "trading"
  ],
  "mcpName": "io.github.nakazanie-ton/xrocket",
  "bin": {
    "xrocket-mcp": "dist/cli.js"
  },
  "exports": {
    ".": "./dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    ".codex-plugin",
    ".mcp.json",
    "server.json",
    "README.md",
    "LICENSE",
    "assets"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build:cli && npm run build:hosted",
    "build:cli": "esbuild src/cli.ts --bundle --platform=node --target=node20 --format=esm --banner:js='#!/usr/bin/env node' --outfile=dist/cli.js && chmod +x dist/cli.js",
    "build:hosted": "esbuild src/hosted.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist/hosted.js",
    "smoke:stdio": "node test/stdio-smoke.mjs",
    "smoke:http": "node test/http-smoke.mjs",
    "start:hosted": "node dist/hosted.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "^26.0.0",
    "esbuild": "^0.28.0",
    "typescript": "^7.0.0",
    "vitest": "^4.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
